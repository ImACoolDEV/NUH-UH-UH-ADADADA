local cooldownBypassActive = false
addToggle(AutoPage, "⚡ BYPASS TOOL COOLDOWN", false, function(state)
    cooldownBypassActive = state
end)

Tasks.CooldownBypassLoop = task.spawn(function()
    while true do
        task.wait(0.1)
        if cooldownBypassActive then
            pcall(function()
                local function checkItem(item)
                    if item:IsA("Tool") then
                        local cd = item:FindFirstChild("Cooldown", true)
                        if cd then
                            if cd:IsA("NumberValue") or cd:IsA("IntValue") then
                                cd.Value = 0
                            elseif cd:IsA("BoolValue") then
                                cd.Value = false
                            elseif cd:IsA("Script") or cd:IsA("LocalScript") then
                                cd.Disabled = true
                            end
                        end
                        if item:GetAttribute("Cooldown") then
                            item:SetAttribute("Cooldown", 0)
                        end
                    end
                end

                local char = LocalPlayer.Character
                local backpack = LocalPlayer:FindFirstChild("Backpack")

                if char then
                    for _, item in ipairs(char:GetChildren()) do checkItem(item) end
                end
                if backpack then
                    for _, item in ipairs(backpack:GetChildren()) do checkItem(item) end
                end
            end)
        end
    end
end)

